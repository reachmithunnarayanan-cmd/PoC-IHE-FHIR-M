{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secure Data Exchange Workstation Sanitisation Profile",
  "description": "PoC configuration for direction-specific field selection and transformation. Not an approved production sanitisation policy.",
  "type": "object",
  "required": [
    "profileId",
    "profileName",
    "version",
    "direction",
    "fields",
    "lockedRules"
  ],
  "properties": {
    "profileId": {
      "type": "string"
    },
    "profileName": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "ADN-TO-PUBLIC",
        "PUBLIC-TO-ADN"
      ]
    },
    "description": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedBy": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonicalFieldId",
          "selected",
          "action"
        ],
        "properties": {
          "canonicalFieldId": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "enum": [
              "pass",
              "transform",
              "add",
              "remove",
              "hold",
              "conditional"
            ]
          },
          "targetPath": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "lockedRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonicalFieldId",
          "action",
          "reason"
        ],
        "properties": {
          "canonicalFieldId": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "remove",
              "hold",
              "add"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "generatedEnvelopeFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mappingVersion": {
      "type": "string"
    },
    "xmlRepresentationVersion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
