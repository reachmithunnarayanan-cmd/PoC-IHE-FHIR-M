{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Field Superset (PoC)",
  "description": "Illustrative logical model for canonical clinical/examination data and directional projections. Not a FHIR or ABDM schema.",
  "type": "object",
  "required": [
    "recordId",
    "person",
    "examinations"
  ],
  "properties": {
    "recordId": {
      "type": "string"
    },
    "person": {
      "type": "object",
      "properties": {
        "sourcePatientId": {
          "type": "string"
        },
        "adnPersonnelNumber": {
          "type": [
            "string",
            "null"
          ],
          "x-domain": "ADN-only"
        },
        "name": {
          "type": "string"
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date"
        },
        "sex": {
          "type": "string"
        },
        "rank": {
          "type": [
            "string",
            "null"
          ],
          "x-domain": "ADN-only"
        },
        "unitShip": {
          "type": [
            "string",
            "null"
          ],
          "x-domain": "ADN-only"
        },
        "service": {
          "type": [
            "string",
            "null"
          ]
        },
        "armsCorps": {
          "type": [
            "string",
            "null"
          ],
          "x-domain": "ADN-only"
        },
        "branchTrade": {
          "type": [
            "string",
            "null"
          ],
          "x-domain": "ADN-only"
        },
        "commissionType": {
          "type": [
            "string",
            "null"
          ],
          "x-domain": "ADN-only"
        },
        "commissionDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "totalService": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "examinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/examination"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "exchange": {
      "$ref": "#/$defs/exchange"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "normal",
            "abnormal",
            "not-recorded",
            "not-applicable",
            "unknown"
          ]
        },
        "value": {},
        "note": {
          "type": "string"
        }
      }
    },
    "investigation": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "reportReference": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        }
      }
    },
    "examination": {
      "type": "object",
      "required": [
        "type",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "PME",
            "AME",
            "SPECIAL"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "place": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "pastMedicalHistory": {
          "type": "string"
        },
        "medicalCategory": {
          "type": "object",
          "properties": {
            "present": {
              "type": "string"
            },
            "effectiveDate": {
              "type": "string",
              "format": "date"
            },
            "boardFitness": {
              "type": "string"
            },
            "final": {
              "type": "string"
            },
            "decisionContext": {
              "type": "string"
            }
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "value": {},
              "unit": {
                "type": "string"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/finding"
          }
        },
        "investigations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/investigation"
          }
        },
        "dental": {
          "type": "object",
          "additionalProperties": true
        },
        "eye": {
          "type": "object",
          "additionalProperties": true
        },
        "ent": {
          "type": "object",
          "additionalProperties": true
        },
        "gynaecology": {
          "type": "object",
          "additionalProperties": true
        },
        "immunisation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "specialistSections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "fieldId",
        "status"
      ],
      "properties": {
        "fieldId": {
          "type": "string"
        },
        "originSystem": {
          "type": "string"
        },
        "originRecord": {
          "type": "string"
        },
        "originField": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "captured",
            "imported",
            "enriched",
            "amended",
            "rejected",
            "not-transferred"
          ]
        },
        "actor": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "transformation": {
          "type": "string"
        }
      }
    },
    "exchange": {
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string"
        },
        "packageId": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "ADN-TO-PUBLIC",
            "PUBLIC-TO-ADN"
          ]
        },
        "sourceSystem": {
          "type": "string"
        },
        "destinationSystem": {
          "type": "string"
        },
        "mappingVersion": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "inputHash": {
          "type": "string"
        },
        "outputHash": {
          "type": "string"
        },
        "transformationSummary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldId": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "pass",
                  "transform",
                  "add",
                  "remove",
                  "hold",
                  "unsupported"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
